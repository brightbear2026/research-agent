{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-agent.local/schemas/chapter-meta-v2.json",
  "title": "Research chapter metadata v2",
  "description": "单章研究元数据。合并后的 chapter_meta.json 是此对象的数组。",
  "type": "object",
  "required": [
    "schema_version",
    "chapter_id",
    "title",
    "reader_question",
    "thesis",
    "argument_role",
    "sources",
    "claims",
    "data_points",
    "screenshots",
    "controversies",
    "gaps",
    "chapter_conclusion"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "chapter_id": {"type": "string", "pattern": "^ch[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "reader_question": {"type": "string", "minLength": 1},
    "thesis": {"type": "string", "minLength": 1},
    "argument_role": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "data_points": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "screenshots": {"type": "array", "items": {"type": "object"}},
    "diagrams": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagram"}
    },
    "controversies": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array"},
    "chapter_conclusion": {"$ref": "#/$defs/chapterConclusion"},
    "research_questions": {"type": "array", "items": {"$ref": "#/$defs/researchQuestion"}},
    "search_log": {"type": "array", "items": {"$ref": "#/$defs/searchEntry"}},
    "search_tasks": {
      "type": "array",
      "description": "阶段三编译的类型化检索任务；status 流转 planned→done/partial/open",
      "items": {"$ref": "#/$defs/searchTask"}
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "confidence": {"enum": ["高", "中高", "中", "中低", "低"]},
    "source": {
      "type": "object",
      "required": ["source_id", "title", "url", "tier"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"], "format": "uri"},
        "origin_url": {"type": ["string", "null"], "format": "uri", "description": "已核实的原始出处 URL；转载与原文合并计算独立性"},
        "organization": {"$ref": "#/$defs/nullableString"},
        "publish_date": {"$ref": "#/$defs/nullableString"},
        "tier": {"enum": ["A", "B", "C", "D", null]},
        "independence_group": {"$ref": "#/$defs/nullableString"},
        "source_type": {"$ref": "#/$defs/nullableString"},
        "authors": {"type": "array", "items": {"type": "string"}},
        "report_type": {"$ref": "#/$defs/nullableString"},
        "covered_entity_or_industry": {"$ref": "#/$defs/nullableString"},
        "page_or_location": {"$ref": "#/$defs/nullableString"},
        "forecast_horizon": {"$ref": "#/$defs/nullableString"},
        "key_assumptions": {"type": "array", "items": {"type": "string"}},
        "primary_data_sources": {"type": "array", "items": {"type": "string"}},
        "rating": {"$ref": "#/$defs/nullableString"},
        "target_price": {"$ref": "#/$defs/nullableString"},
        "conflict_disclosure": {"$ref": "#/$defs/nullableString"},
        "access_date": {"$ref": "#/$defs/nullableString"},
        "access_notes": {"$ref": "#/$defs/nullableString"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id", "text", "source_ids", "supporting_evidence_ids",
        "opposing_evidence_ids", "confidence", "limitations"
      ],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "text": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "opposing_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "confidence": {"$ref": "#/$defs/confidence"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "priority": {
          "enum": ["P0", "P1", null],
          "description": "可选优先级；标 P0 = 该结论须有 A/B 级来源背书（qc 强校验）"
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id", "claim_id", "source_ids", "value", "unit",
        "stat_time", "region", "population_or_scope", "definition",
        "confidence", "limitations"
      ],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "claim_id": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "value": {},
        "unit": {"$ref": "#/$defs/nullableString"},
        "stat_time": {"$ref": "#/$defs/nullableString"},
        "region": {"$ref": "#/$defs/nullableString"},
        "population_or_scope": {"$ref": "#/$defs/nullableString"},
        "definition": {"$ref": "#/$defs/nullableString"},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "chapterConclusion": {
      "type": "object",
      "required": [
        "claim_id", "judgment", "supporting_evidence_ids",
        "opposing_evidence_ids", "conditions", "time_range", "confidence",
        "limitations", "decision_implication"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "judgment": {"type": "string", "minLength": 1},
        "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "opposing_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "conditions": {"type": "string"},
        "time_range": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "priority": {"enum": ["P0", "P1", null]},
        "decision_implication": {"type": "string"}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["source_id", "locator", "excerpt", "access_date"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1},
        "access_date": {"type": "string", "format": "date"}
      }
    },
    "researchQuestion": {
      "type": "object",
      "required": ["question_id", "question", "status", "evidence_ids"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "status": {"enum": ["answered", "partial", "unanswered"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "gap_reason": {"type": "string"}
      }
    },
    "searchEntry": {
      "type": "object",
      "required": ["question_id", "query", "intent", "outcome", "source_ids", "reason"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "intent": {"enum": ["support", "counter", "background"]},
        "outcome": {"enum": ["new_evidence", "no_new_evidence", "blocked"]},
        "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "searchTask": {
      "type": "object",
      "required": ["task_id", "type", "focus", "status"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "type": {
          "enum": ["explore", "refute", "pin"],
          "description": "explore=章节探索；refute=反方/局限检索；pin=必引原文定向锁定"
        },
        "focus": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "done", "partial", "open"]},
        "result": {"type": "string", "description": "status=done 时必填：一句话记录结果"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "note": {"type": "string"}
      }
    },
    "diagram": {
      "type": "object",
      "required": [
        "fig_id", "title", "visual_type", "source_html", "local_path",
        "size", "detail", "profile", "source_ids", "supports_claim_ids", "alt_text"
      ],
      "properties": {
        "fig_id": {"type": "string", "pattern": "^FIG-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1},
        "visual_type": {"type": "string", "minLength": 1},
        "source_html": {"type": "string", "pattern": "^diagrams/[^/]+\\.html$"},
        "local_path": {"type": "string", "pattern": "^images/[^/]+\\.png$"},
        "size": {"enum": ["compact", "standard", "doc-wide", "hero"]},
        "detail": {"enum": ["minimal", "balanced", "rich"]},
        "profile": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "supports_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "alt_text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
