<!DOCTYPE html>
<html lang="{{ meta.get('language','zh-CN') }}" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ meta.get('title','深度研究报告') }}{% if meta.get('subtitle') %} · {{ meta.subtitle }}{% endif %}</title>
<style>
  :root{
    --bg:#ffffff; --bg-soft:#f7f7f8; --card:#ffffff; --border:#e4e4e7;
    --text:#18181b; --text-soft:#52525b; --muted:#a1a1aa;
    --primary:#1e3a8a; --primary-soft:#dbeafe; --accent:#0f766e;
    --tag-fact:#0f766e; --tag-opinion:#7c3aed; --tag-org:#1d4ed8;
    --tag-dispute:#b91c1c; --tag-judge:#a16207; --tag-guess:#6b7280;
    --shadow:0 1px 3px rgba(0,0,0,.08);
  }
  [data-theme="dark"]{
    --bg:#0b0b0f; --bg-soft:#15151c; --card:#15151c; --border:#27272a;
    --text:#f4f4f5; --text-soft:#d4d4d8; --muted:#71717a;
    --primary:#93c5fd; --primary-soft:#1e293b; --accent:#5eead4;
    --shadow:0 1px 3px rgba(0,0,0,.5);
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei","Segoe UI",Roboto,sans-serif;
       background:var(--bg);color:var(--text);line-height:1.75;font-size:16px;-webkit-font-smoothing:antialiased}
  a{color:var(--primary);text-decoration:none}
  a:hover{text-decoration:underline}

  /* toolbar */
  .toolbar{position:fixed;top:0;left:0;right:0;height:52px;z-index:50;display:flex;align-items:center;
           gap:8px;padding:0 16px;background:var(--bg-soft);border-bottom:1px solid var(--border);box-shadow:var(--shadow)}
  .toolbar .t-title{font-weight:600;font-size:14px;color:var(--text-soft);overflow:hidden;white-space:nowrap;text-overflow:ellipsis;flex:1}
  .btn{cursor:pointer;border:1px solid var(--border);background:var(--card);color:var(--text);border-radius:8px;
       padding:6px 12px;font-size:13px}
  .btn:hover{border-color:var(--primary)}

  /* layout */
  .layout{display:flex;max-width:1280px;margin:0 auto;padding-top:64px}
  nav.toc{width:260px;flex-shrink:0;position:sticky;top:64px;height:calc(100vh - 64px);overflow-y:auto;
          padding:24px 16px;border-right:1px solid var(--border);font-size:13.5px}
  nav.toc a{display:block;color:var(--text-soft);padding:4px 8px;border-radius:6px;border-left:2px solid transparent}
  nav.toc a:hover{background:var(--bg-soft);text-decoration:none}
  nav.toc a.active{color:var(--primary);border-left-color:var(--primary);background:var(--primary-soft);font-weight:500}
  nav.toc .toc-h3{padding-left:22px;font-size:12.5px;color:var(--muted)}
  main{flex:1;min-width:0;padding:32px 48px 120px}
  #menu-toggle{display:none}

  /* cover */
  .cover{border-bottom:3px solid var(--primary);padding-bottom:24px;margin-bottom:28px}
  .cover h1{font-size:30px;line-height:1.3;margin:0 0 8px}
  .cover .sub{font-size:18px;color:var(--text-soft);margin-bottom:18px}
  .meta-grid{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:13px;color:var(--muted)}
  .meta-grid b{color:var(--text-soft)}

  /* cards */
  .card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px 22px;margin:18px 0;box-shadow:var(--shadow)}
  .card h3{margin:0 0 8px;font-size:16px;color:var(--primary)}
  .keyfind{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin:18px 0}
  .keyfind .kf{background:var(--bg-soft);border:1px solid var(--border);border-radius:10px;padding:14px 16px}
  .keyfind .kf .n{font-size:12px;color:var(--accent);font-weight:700;letter-spacing:.05em}

  /* content typography */
  h1,h2,h3,h4{scroll-margin-top:80px;line-height:1.35}
  main h2{font-size:24px;border-bottom:1px solid var(--border);padding-bottom:8px;margin-top:40px}
  main h3{font-size:19px;margin-top:26px}
  main p{margin:12px 0}
  blockquote{margin:16px 0;padding:10px 16px;border-left:4px solid var(--primary);background:var(--bg-soft);color:var(--text-soft);border-radius:0 8px 8px 0}
  code{background:var(--bg-soft);padding:2px 6px;border-radius:4px;font-size:.9em}
  hr{border:none;border-top:1px solid var(--border);margin:32px 0}

  /* tables */
  .table-wrap{overflow-x:auto;margin:18px 0;border:1px solid var(--border);border-radius:8px;max-width:100%;
    box-shadow:var(--shadow)}
  .table-wrap table{margin:0}
  table{border-collapse:collapse;width:100%;font-size:13.5px;font-variant-numeric:tabular-nums}
  th,td{padding:9px 12px;border-bottom:1px solid var(--border);text-align:left;vertical-align:top;
    word-break:break-word;overflow-wrap:anywhere}
  th{background:var(--bg-soft);font-weight:600;white-space:nowrap}
  tbody tr:nth-child(even){background:var(--bg-soft)}
  tbody tr:hover{background:var(--primary-soft)}
  tbody td:first-child{font-weight:600;color:var(--text)}
  .table-wrap table caption{caption-side:top;font-size:13px;color:var(--muted);padding:6px 12px;text-align:left}

  /* 时间线（竖向时间轴，由「年份：事件」列表转换而来） */
  ol.timeline{list-style:none;margin:22px 0;padding:2px 0 2px 28px;border-left:2px solid var(--border)}
  ol.timeline li{position:relative;margin:0 0 14px}
  ol.timeline li::before{content:"";position:absolute;left:-35px;top:6px;width:12px;height:12px;border-radius:50%;
    background:var(--primary);box-shadow:0 0 0 3px var(--card),0 0 0 5px var(--primary-soft)}
  ol.timeline .t-time{display:inline-block;font-weight:700;color:var(--primary);font-variant-numeric:tabular-nums;
    font-size:13.5px;margin-bottom:2px}
  ol.timeline .t-body{display:block;color:var(--text-soft);font-size:14.5px;line-height:1.7}
  ol.timeline .t-body :is(strong,b){color:var(--text)}

  /* figures */
  figure{margin:18px 0;text-align:center}
  figure img{max-width:100%;height:auto;border:1px solid var(--border);border-radius:8px;cursor:zoom-in}
  figcaption{font-size:13px;color:var(--muted);margin-top:6px;text-align:center}
  figcaption b{color:var(--text-soft)}

  /* mermaid 概念图（由 Mermaid.js 渲染；离线/被墙时降级 .mermaid-fallback 显示源码） */
  .mermaid{margin:20px auto;text-align:center;max-width:100%;overflow-x:auto}
  .mermaid svg{max-width:100%;height:auto}
  .mermaid-fallback{margin:18px 0;padding:14px;background:var(--bg-soft);border:1px dashed var(--border);
    border-radius:8px;white-space:pre-wrap;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
    font-size:12.5px;color:var(--text-soft);overflow-x:auto;line-height:1.5}

  /* citations */
  a.cite{color:var(--accent);font-weight:600;font-size:.85em;white-space:nowrap}
  .references{font-size:13.5px}
  .references ol{padding-left:22px}
  .references li{margin:6px 0;color:var(--text-soft);word-break:break-word}

  /* inline tags */
  .tag{display:inline-block;font-size:11px;font-weight:700;padding:1px 7px;border-radius:4px;margin-right:4px;vertical-align:middle}
  .tag-fact{background:#ccfbf1;color:#115e59}
  .tag-opinion{background:#ede9fe;color:#5b21b6}
  .tag-org{background:#dbeafe;color:#1e40af}
  .tag-dispute{background:#fee2e2;color:#991b1b}
  .tag-judge{background:#fef3c7;color:#854d0e}
  .tag-guess{background:#f1f5f9;color:#475569}

  /* back to top */
  .back-to-top{position:fixed;right:24px;bottom:24px;width:44px;height:44px;border-radius:50%;
               background:var(--primary);color:#fff;border:none;cursor:pointer;font-size:20px;
               box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:opacity .2s;z-index:40}
  .back-to-top.show{opacity:1;pointer-events:auto}

  /* responsive */
  @media (max-width:920px){
    nav.toc{position:fixed;top:52px;left:0;height:auto;max-height:70vh;width:240px;transform:translateX(-110%);
            transition:transform .2s;background:var(--bg);z-index:45;padding-top:16px}
    nav.toc.open{transform:translateX(0)}
    main{padding:24px 18px 100px}
    #menu-toggle{display:inline-block}
    .toolbar .t-title{font-size:12px}
  }
  @media print{
    nav.toc,.toolbar,.back-to-top,.no-print{display:none !important}
    main{padding:0}
    body{background:#fff;color:#000;font-size:11pt}
    a{color:#000}
    .cover{border-color:#000}
    figure img{border:none}
    .page-break{page-break-before:always}
  }
</style>
</head>
<body>

<div class="toolbar no-print">
  <button id="menu-toggle" class="btn" aria-label="目录">☰ 目录</button>
  <span class="t-title">{{ meta.get('title','深度研究报告') }}</span>
  <button id="theme-toggle" class="btn">🌙 深色</button>
  <button id="print-btn" class="btn">🖨️ 打印 / PDF</button>
</div>

<div class="layout">
  <nav class="toc" id="toc">
    <div style="font-weight:700;margin-bottom:8px;color:var(--primary)">目录导航</div>
    {% for item in nav %}
      <a href="#{{ item.id }}" class="toc-h{{ item.level }}">{{ item.text }}</a>
    {% endfor %}
  </nav>

  <main>
    <div class="cover">
      <h1>{{ meta.get('title','深度研究报告') }}</h1>
      {% if meta.get('subtitle') %}<div class="sub">{{ meta.subtitle }}</div>{% endif %}
      <div class="meta-grid">
        {% if meta.get('research_topic') %}<span><b>课题：</b>{{ meta.research_topic }}</span>{% endif %}
        {% if meta.get('version') %}<span><b>版本：</b>{{ meta.version }}</span>{% endif %}
        {% if meta.get('created_date') %}<span><b>生成日期：</b>{{ meta.created_date }}</span>{% endif %}
        {% if meta.get('data_cutoff_date') %}<span><b>数据截止：</b>{{ meta.data_cutoff_date }}</span>{% endif %}
        {% if meta.get('depth') %}<span><b>深度：</b>{{ meta.depth }}</span>{% endif %}
      </div>
      {% if meta.get('research_scope') or meta.get('target_audience') %}
      <div class="meta-grid" style="margin-top:6px">
        {% if meta.get('research_scope') %}<span><b>研究范围：</b>{{ meta.research_scope }}</span>{% endif %}
        {% if meta.get('target_audience') %}<span><b>目标读者：</b>{{ meta.target_audience }}</span>{% endif %}
      </div>
      {% endif %}
    </div>

    {{ body_html | safe }}

    {% if refs_html %}
    <h2 id="references-section">参考文献</h2>
    <div class="references">{{ refs_html | safe }}</div>
    {% endif %}

    <hr>
    <p style="font-size:12px;color:var(--muted)">
      本报告由深度研究代理生成。所有 `[n]` 引用对应参考文献；截图索引见 <code>data/figures.csv</code>，证据矩阵见 <code>evidence/</code>。
      禁止将占位图或自制图表当作原始机构材料引用。
    </p>
  </main>
</div>

<button class="back-to-top no-print" id="back-top" aria-label="返回顶部">↑</button>

<script>
  // 主题切换
  (function(){
    var root=document.documentElement, btn=document.getElementById('theme-toggle');
    var saved=localStorage.getItem('dr-theme'); if(saved) root.setAttribute('data-theme',saved);
    function setLabel(){ btn.textContent = root.getAttribute('data-theme')==='dark' ? '☀️ 浅色' : '🌙 深色'; }
    setLabel();
    btn.addEventListener('click',function(){
      var cur=root.getAttribute('data-theme')==='dark'?'light':'dark';
      root.setAttribute('data-theme',cur); localStorage.setItem('dr-theme',cur); setLabel();
    });
  })();
  // 打印
  document.getElementById('print-btn').addEventListener('click',function(){window.print();});
  // 移动端目录
  document.getElementById('menu-toggle').addEventListener('click',function(){
    document.getElementById('toc').classList.toggle('open');
  });
  // 返回顶部
  var bt=document.getElementById('back-top');
  window.addEventListener('scroll',function(){ bt.classList.toggle('show',window.scrollY>500); });
  bt.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});
  // 当前章节高亮
  (function(){
    var links=[].slice.call(document.querySelectorAll('nav.toc a'));
    var map={}; links.forEach(function(a){ map[a.getAttribute('href').slice(1)]=a; });
    var ids=Object.keys(map);
    if('IntersectionObserver' in window){
      var obs=new IntersectionObserver(function(entries){
        entries.forEach(function(e){ if(e.isIntersecting){
          links.forEach(function(l){l.classList.remove('active');});
          if(map[e.target.id]) map[e.target.id].classList.add('active');
        }});
      },{rootMargin:'0px 0px -75% 0px'});
      ids.forEach(function(id){var el=document.getElementById(id); if(el) obs.observe(el);});
    }
  })();
</script>

  <!-- Mermaid 概念图：需联网加载 CDN；离线/被墙时降级为原始文本 -->
  <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"
          onerror="this.remove();document.querySelectorAll('.mermaid').forEach(function(e){e.className='mermaid-fallback';})"></script>
  <script>
    if (window.mermaid) {
      mermaid.initialize({ startOnLoad: true, theme: 'neutral', securityLevel: 'loose', fontFamily: 'inherit' });
    }
  </script>
</body>
</html>
